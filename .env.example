# Copy to .env (copy .env.example .env) and edit. .env is git-ignored; never commit it.

# --- Image versions (pinned on purpose; upgrade deliberately) ---
# Home Assistant container tag (https://github.com/home-assistant/core/releases)
HA_IMAGE_TAG=2026.11.0
# rhasspy/wyoming-whisper tag (Docker Hub)
WHISPER_IMAGE_TAG=3.8.1
# rhasspy/wyoming-piper tag (Docker Hub)
PIPER_IMAGE_TAG=2.5.2

# --- Settings ---
# Your timezone (IANA name), e.g. America/New_York, Europe/London
TZ=Etc/UTC
# Whisper speech-to-text model; try medium-int8 if accuracy is poor
WHISPER_MODEL=small-int8
# Piper voice used for spoken answers
PIPER_VOICE=en_GB-alba-medium

# --- Used by scripts (smoke test) ---
# Home Assistant address
HA_URL=http://localhost:8123
# Long-lived access token from your HA profile page (see docs/setup-windows.md); leave blank until created
HA_TOKEN=
# Entity id of the Anthropic conversation agent, e.g. conversation.claude_conversation (find it in HA:
# Settings > Devices & services > Entities, search "conversation"). Needed so the smoke test talks to
# Claude; if blank, Home Assistant's built-in agent answers instead.
HA_AGENT_ID=
# Whisper Wyoming host/port as seen from this PC
WHISPER_HOST=localhost
WHISPER_PORT=10300
# Piper Wyoming host/port as seen from this PC
PIPER_HOST=localhost
PIPER_PORT=10200
